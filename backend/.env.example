# ==============================================================================
# GSTRecon Backend Configuration
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gstrecon

# Maximum file upload size in MB (default 10 MB)
MAX_FILE_SIZE_MB=10

# Reconciliation arithmetic tolerance in INR (default 1.00)
RECONCILIATION_TOLERANCE=1.00

# Date discrepancy tolerance in days (default 30)
DISCREPANCY_DATE_TOLERANCE_DAYS=30

# ------------------------------------------------------------------------------
# AI Ambiguous Invoice Matching Configuration
# ------------------------------------------------------------------------------
# Supported Providers: 'gemini' (Recommended), 'mistral', 'mock'
# If GEMINI_API_KEY or GOOGLE_API_KEY is present, 'gemini' is auto-detected.

# Option 1: Google Gemini (Recommended)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash

# Option 2: Mistral AI
# LLM_PROVIDER=mistral
# MISTRAL_API_KEY=your_mistral_api_key_here
# LLM_MODEL=mistral-small-latest

# Option 3: Mock Provider (Deterministic simulation for local testing without external API calls)
# LLM_PROVIDER=mock

# AI Matching Limits and Timing
LLM_TIMEOUT_SECONDS=15.0
MAX_AI_CANDIDATES_PER_RECORD=3
MAX_AI_ASSESSMENTS_PER_JOB=10
CANDIDATE_SIMILARITY_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# SMTP Email & Vendor Notice Dispatch Configuration
# ------------------------------------------------------------------------------
# Set to 'true' to enable notice sending; 'false' to disable
SMTP_ENABLED=true

# Test Mode Security:
# 'true' restricts email dispatch strictly to configured test recipients to prevent
# accidental emails to real suppliers from uploaded files.
SMTP_TEST_MODE=true
SMTP_TEST_RECIPIENT=test-receiver@gst-recon.local
SMTP_ALLOWED_RECIPIENTS=test-receiver@gst-recon.local,accounts@omkarengg.in

# Outgoing SMTP Server Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=accounts@omkarengg.in
SMTP_FROM_NAME=Omkar Precision Engineering Accounts
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=5.0

